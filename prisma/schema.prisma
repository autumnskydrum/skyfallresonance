// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id        String     @id @default(cuid())
  title     String
  content   String
  resolved  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  answers   Answer[]
}

model Answer {
  id         String   @id @default(cuid())
  content    String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
}

model NewsArticle {
  id          String   @id @default(cuid())
  title       String
  url         String   @unique
  source      String
  summary     String?
  publishedAt DateTime?
  crawledAt   DateTime @default(now())
}

// 기상 데이터 다중 소스 비교 (Open-Meteo, MET Norway, 기상청, WeatherAPI.com, SMHI).
// 도시+소스 조합당 최신 값 하나만 유지 (히스토리 누적 안 함) — 수집 스케줄러가 매 주기 upsert.
model WeatherReading {
  id           String   @id @default(cuid())
  citySlug     String
  cityName     String
  countryCode  String
  source       String
  temperatureC Float
  condition    String?
  observedAt   DateTime
  fetchedAt    DateTime @default(now())

  @@unique([citySlug, source])
}

// 7일 일별 예보 (최고/최저기온). 소스별 지원 기간이 달라 도시+소스+날짜 조합당
// 최신 값 하나만 유지한다 — 지원 안 하는 미래 날짜는 그 소스만 자연스럽게 빠진다.
model WeatherDailyForecast {
  id           String   @id @default(cuid())
  citySlug     String
  cityName     String
  countryCode  String
  source       String
  forecastDate DateTime
  tempMaxC     Float
  tempMinC     Float
  condition    String?
  fetchedAt    DateTime @default(now())

  @@unique([citySlug, source, forecastDate])
}

// 오늘 기준 24시간 시간별 예보. 소스마다 시간 간격이 달라(기상청은 3시간 단위 등) 도시+소스+forecastHour
// 조합당 최신 값 하나만 유지한다 — 간격이 성긴 소스는 자연스럽게 일부 시간대만 채운다(7일 예보와 동일한 철학).
// forecastHour가 매 수집 주기마다 "지금"을 기준으로 굴러가므로, 지나간 시각의 행은 수집 시점에 정리한다
// (WeatherReading/WeatherDailyForecast와 달리 unique 키 자체가 시간마다 새로 생기기 때문).
model WeatherHourlyForecast {
  id           String   @id @default(cuid())
  citySlug     String
  cityName     String
  countryCode  String
  source       String
  forecastHour DateTime
  temperatureC Float
  condition    String?
  fetchedAt    DateTime @default(now())

  @@unique([citySlug, source, forecastHour])
}
